{
    "name": "backpack/pan-panel",
    "description": "A pan analytics viewer",
    "keywords": ["laravel", "backpack", "pan"],
    "license": "MIT",
    "require": {
        "backpack/crud": "^7.0.0-alpha",
        "panphp/pan": "^0.1.7"
    },
    "autoload": {
        "psr-4": {
            "Backpack\\Pan\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Backpack\\Pan\\BackpackPanServiceProvider"
            ]
        }
    }
}
